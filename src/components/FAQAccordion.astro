---
import { toHtml } from '../utils/inline-markdown';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
  /** Heading rendered above the list. Pass null to omit. */
  heading?: string | null;
  headingId?: string;
  /** The first item opens by default so the section never reads as empty. */
  openFirst?: boolean;
}

const {
  faqs,
  heading = 'Frequently asked questions',
  headingId = 'faqs',
  openFirst = true,
} = Astro.props;
---

<div class="faqs">
  {heading && <h2 class="faqs__heading" id={headingId}>{heading}</h2>}

  <div class="faqs__list">
    {
      faqs.map((faq, i) => (
        <details class="faq" open={openFirst && i === 0}>
          <summary class="faq__q">
            <span>{faq.question}</span>
            <svg class="faq__chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                d="M3 6l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div class="faq__a">
            <p set:html={toHtml(faq.answer)} />
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faqs__heading {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }

  .faqs__list {
    border-top: 1px solid var(--line);
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 650;
    line-height: 1.4;
    color: var(--navy-900);
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--copper-700);
  }

  .faq__chevron {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
    margin-top: 0.32rem;
    color: var(--copper-600);
    transition: transform 0.2s ease;
  }

  .faq[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__a {
    padding-bottom: var(--space-m);
    padding-right: clamp(0rem, 4vw, 2.5rem);
  }

  .faq__a p {
    color: var(--ink-muted);
    line-height: 1.68;
  }

  /* On navy sections */
  :global(.section--navy) .faqs__list,
  :global(.section--navy) .faq {
    border-color: rgb(255 255 255 / 0.14);
  }

  :global(.section--navy) .faq__q {
    color: #fff;
  }

  :global(.section--navy) .faq__q:hover {
    color: var(--copper-400);
  }

  :global(.section--navy) .faq__a p {
    color: var(--on-navy-muted);
  }
</style>
