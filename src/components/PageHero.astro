---
import Breadcrumbs from './Breadcrumbs.astro';
import CallButton from './CallButton.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Breadcrumb label; omit to hide breadcrumbs (404). */
  crumb?: string;
  showCall?: boolean;
}

const { eyebrow, title, lede, crumb, showCall = true } = Astro.props;
---

<section class="page-hero">
  <div class="hero__mesh" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>
  <div class="container">
    {crumb && <Breadcrumbs current={crumb} />}
    <p class="eyebrow" style="margin-top:28px">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="page-hero__lede">{lede}</p>}
    {
      showCall && (
        <div class="page-hero__actions">
          <CallButton />
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
