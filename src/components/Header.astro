---
import { getCollection } from 'astro:content';
import { site, primaryNav } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';

/**
 * Dropdown contents come straight from the collections, so a new service or
 * location markdown file shows up in the menus with no extra wiring.
 */
const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const locations = (await getCollection('locations', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

const menus = {
  services: services.map((s) => ({ href: `/${s.id}/`, label: s.data.title, icon: s.data.icon })),
  locations: [
    { href: '/', label: `${site.city}, ${site.state}`, icon: 'pin' },
    ...locations.map((l) => ({ href: `/${l.id}/`, label: `${l.data.title}, MD`, icon: 'pin' })),
  ],
} as const;
---

<div class="topbar">
  <div class="container">
    <span class="topbar__area"><Icon name="pin" />{site.serviceAreaLine}</span>
    <a class="topbar__mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
  </div>
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          primaryNav.map((item) => {
            const menu = 'menu' in item ? menus[item.menu] : undefined;
            return (
              <li class="nav__item">
                <a class="nav__link" href={item.href}>
                  {item.label}
                  {menu && <Icon name="chevron" />}
                </a>
                {menu && (
                  <ul class="nav__menu">
                    {menu.map((link) => (
                      <li>
                        <a href={link.href}>
                          <Icon name={link.icon as any} />
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <CallButton size="sm" class="header-call" />

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-panel" data-nav-open>
      <Icon name="menu" />
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<div class="mobile-panel" id="mobile-panel" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="mobile-panel__top">
    <Logo tone="dark" />
    <button class="nav-toggle" type="button" data-nav-close>
      <Icon name="close" />
      <span class="visually-hidden">Close menu</span>
    </button>
  </div>
  <div class="mobile-panel__group">
    <p class="mobile-panel__label">Leak repairs</p>
    <ul>{menus.services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </div>
  <div class="mobile-panel__group">
    <p class="mobile-panel__label">Areas</p>
    <ul>{menus.locations.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </div>
  <div class="mobile-panel__group">
    <ul>
      <li><a href="/about/">About</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </div>
  <CallButton />
</div>
