---
import { site } from '../config/site';
import CallButton from './CallButton.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow = 'Water coming in?', title, text } = Astro.props;
---

<section class="section section--white" aria-label="Call to action">
  <div class="container">
    <div class="cta-band" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      {text && <p>{text}</p>}
      <a class="cta-band__phone" href={site.phone.href} data-call>{site.phone.display}</a>
      <div>
        <CallButton label="Tap to call now" />
      </div>
    </div>
  </div>
</section>
