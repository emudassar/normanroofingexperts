---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  wide?: boolean;
  /** Prepend a phone glyph, for click-to-call buttons. */
  phone?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  wide = false,
  phone = false,
  class: className = '',
} = Astro.props;

const classes = ['btn', `btn--${variant}`, wide && 'btn--wide', className]
  .filter(Boolean)
  .join(' ');
---

<a class={classes} href={href}>
  {
    phone && (
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" class="btn__icon">
        <path
          d="M4.2 2.5h3l1.5 3.7-1.9 1.4a10.5 10.5 0 0 0 4.6 4.6l1.4-1.9 3.7 1.5v3a1.5 1.5 0 0 1-1.6 1.5A13.6 13.6 0 0 1 2.7 4.1 1.5 1.5 0 0 1 4.2 2.5Z"
          fill="currentColor"
        />
      </svg>
    )
  }
  <slot />
</a>

<style>
  .btn__icon {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
  }
</style>
