---
/**
 * Line-art icons, drawn to one grid so the service cards read as a set.
 * Keys match the `icon` field on the services collection.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
  // Roof with a wrench (repair)
  repair: `<path d="M3 14 16 4l13 10" /><path d="M7 16v11h18V16" /><path d="M20.5 19.5a3.4 3.4 0 0 0-4.6 4l-3.2 3.2 1.7 1.7 3.2-3.2a3.4 3.4 0 0 0 4-4.6l-1.8 1.8-1.4-1.4Z" />`,
  // Roof with layered shingles peeling back (replacement)
  replacement: `<path d="M3 15 16 5l13 10" /><path d="M7 17v10h18V17" /><path d="M10 21h12" /><path d="M10 24.5h12" /><path d="M22 12l6-4 1 3" />`,
  // Roof inside a magnifier (inspection)
  inspection: `<circle cx="14" cy="14" r="9" /><path d="m21 21 7 7" /><path d="M9.5 14.5 14 10.5l4.5 4" /><path d="M11 15.5V19h6v-3.5" />`,
  // Cloud with hail and a roofline (storm)
  storm: `<path d="M9 15a5 5 0 0 1 9.4-2.4A4 4 0 1 1 23 20H10a4.5 4.5 0 0 1-1-8.9" /><path d="M11 24v1.5" /><path d="M16 24v3" /><path d="M21 24v1.5" /><path d="M13.5 28.5h.01" /><path d="M18.5 28.5h.01" />`,
  // Gutter section with a downspout and water
  gutter: `<path d="M4 9 16 3l12 6" /><path d="M4 13h24" /><path d="M4 13v4a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2v-4" /><path d="M24 19v9" /><path d="M24 28h4" /><path d="M11 23v2" /><path d="M15 23v3" />`,
  // House (residential)
  residential: `<path d="M3 15 16 4l13 11" /><path d="M7 17v11h18V17" /><path d="M13 28v-7h6v7" /><path d="M23 8h3v4" />`,
  // Flat-roofed block (commercial)
  commercial: `<path d="M4 27V9h11v18" /><path d="M15 27V15h13v12" /><path d="M8 13h3" /><path d="M8 18h3" /><path d="M8 23h3" /><path d="M19 20h5" /><path d="M19 24h5" /><path d="M3 27h26" />`,
};

const d = paths[name] ?? paths.residential;
---

<svg
  class:list={['svc-icon', className]}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>

<style>
  .svc-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--copper-600);
    flex-shrink: 0;
  }
</style>
