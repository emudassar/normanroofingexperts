---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  location: CollectionEntry<'locations'>;
  /** Card images below the fold are lazy by default. */
  loading?: 'lazy' | 'eager';
}

const { location, loading = 'lazy' } = Astro.props;
const { title, summary, county, heroImage, heroImageAlt } = location.data;
---

<article class="card area-card">
  <div class="area-card__media">
    <Image
      src={heroImage}
      alt={heroImageAlt}
      widths={[320, 480, 640]}
      sizes="(max-width: 40rem) 100vw, (max-width: 68rem) 45vw, 22rem"
      format="webp"
      quality={70}
      loading={loading}
      decoding="async"
    />
  </div>
  <div class="card__body">
    <p class="area-card__county">{county}</p>
    <h3 class="card__title">
      <a href={`/service-areas/${location.id}/`}>{title}</a>
    </h3>
    <p class="card__text">{summary}</p>
  </div>
</article>

<style>
  .area-card {
    position: relative;
  }

  .area-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface-sunk);
  }

  .area-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .area-card:hover .area-card__media :global(img) {
    transform: scale(1.04);
  }

  .area-card__county {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copper-600);
  }
</style>
