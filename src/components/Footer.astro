---
import { getCollection } from 'astro:content';
import { site, legalNav } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const locations = (await getCollection('locations', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo tone="dark" />
        <p>
          Help for leaking roofs in {site.city}, {site.stateName}: flashing, chimneys, skylights, vents,
          flat roofs and storm damage. One call connects you with a local roofing provider.
        </p>
        <a class="footer-phone" href={site.phone.href} data-call>{site.phone.display}</a>
      </div>

      <div>
        <h2>Leak repairs</h2>
        <ul>
          <li><a href="/">Roof leak repair, {site.city}</a></li>
          {services.map((s) => <li><a href={`/${s.id}/`}>{s.data.title}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Areas</h2>
        <ul>
          <li><a href="/">{site.city}, {site.state}</a></li>
          {locations.map((l) => <li><a href={`/${l.id}/`}>{l.data.title}, MD</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Contact</h2>
        <ul class="footer-contact">
          <li><Icon name="phone" /><a href={site.phone.href} data-call>{site.phone.display}</a></li>
          <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /><span>{site.serviceAreaLine}</span></li>
          <li><a href="/about/">About us</a></li>
          <li><a href="/contact/">Contact page</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p><strong>Disclaimer:</strong> {site.disclosure} We are not a roofing contractor and do not perform repairs, and we don't guarantee the work, pricing or availability of any provider. Confirm licensing and insurance directly with the provider before work begins.</p>
      <div class="footer-legal">
        <span>© {year} {site.name}</span>
        {legalNav.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>

<div class="callbar">
  <a class="btn btn--call" href={site.phone.href} data-call>
    <Icon name="phone" />
    <span>Call {site.phone.display}</span>
  </a>
</div>
