---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const url = `${site.url}/terms/`;

const schema = [
  { '@type': 'WebPage', '@id': `${url}#page`, name: 'Terms of Service', url, isPartOf: { '@id': `${site.url}/#website` } },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: url },
    ],
  },
];
---

<BaseLayout
  title={`Terms of Service | ${site.name}`}
  description="Terms for using normanroofingexperts.com, a free referral service for roof leak repair in Severna Park, MD. The site is information, not a quote."
  schema={schema}
>
  <PageHero eyebrow="Legal" title="Terms of Service" lede="Effective October 2026." crumb="Terms of Service" showCall={false} />

  <section class="section section--white">
    <div class="container container--narrow prose legal">
      <p>
        These terms govern your use of <strong>normanroofingexperts.com</strong> (the "site"), operated by {site.name}
        ("we", "us"). By using the site you accept them.
      </p>

      <h2>1. We are a referral service</h2>
      <p>
        <strong>We don't perform roofing work.</strong> Calls to {site.phone.display} are connected to an independent
        roofing provider. That provider is solely responsible for its inspections, quotes, work, licensing, insurance,
        warranties and conduct. Any agreement for work is between you and the provider, and their written proposal
        governs that work, not these terms. We may be paid by providers or call-routing partners for connected calls.
      </p>

      <h2>2. Information, not advice or quotes</h2>
      <p>
        Content on this site is general information about roof leaks. It is not professional, legal or insurance advice,
        and nothing here is a price quote or a guarantee of any outcome. Only a provider can price your repair, after
        seeing your roof. Statements about insurance describe how things generally work; your policy and insurer decide
        coverage.
      </p>

      <h2>3. Safety</h2>
      <p>
        Safety tips on this site are for inspecting from the ground or inside your home. Don't climb onto a roof; leave
        roof work to qualified professionals.
      </p>

      <h2>4. Choosing a provider</h2>
      <p>
        We don't guarantee the availability, response time, price or quality of any provider. Before work starts,
        confirm the provider's Maryland Home Improvement Commission licence and insurance and get the scope and price in
        writing.
      </p>

      <h2>5. Use of the site</h2>
      <p>
        Don't use the site unlawfully, attempt unauthorised access, or copy substantial parts of its content without
        permission. The text, design and original graphics are ours.
      </p>

      <h2>6. Limitation of liability</h2>
      <p>
        The site is provided "as is". To the fullest extent permitted by law, we aren't liable for indirect or
        consequential loss arising from use of the site or reliance on its content, or for the acts or omissions of any
        provider. Nothing here limits liability that can't lawfully be limited.
      </p>

      <h2>7. Governing law</h2>
      <p>These terms are governed by the laws of the State of {site.stateName}.</p>

      <h2>8. Changes and contact</h2>
      <p>
        We may revise these terms; the effective date above changes when we do. Questions:
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
