---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';

const url = `${site.url}/free-estimate/`;

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${url}#page`,
    name: 'Free Roofing Estimate in Norman, OK',
    url,
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Free Estimate', item: url },
    ],
  },
];

const steps = [
  {
    title: 'You send the form or call',
    body: 'Tell us what the roof is doing and roughly where you are. Mention an active leak so your request is flagged as urgent.',
  },
  {
    title: 'Your request goes to a local provider',
    body: 'A roofing provider serving your area receives your details and reaches out directly to schedule a visit. Timing varies by season and provider, especially after a regional hail event.',
  },
  {
    title: 'An on-site look at the roof',
    body: 'A proper inspection covers the roof surface, penetrations, flashings, gutters, and the attic where there is safe access. Ask for photographs of anything they find.',
  },
  {
    title: 'Findings, then a written price',
    body: 'A reputable provider walks you through what they found in plain language and gives you a line-itemed written quote before any work begins.',
  },
];
---

<BaseLayout
  title="Free Roofing Estimate in Norman, OK | Request an Inspection"
  description="Request a free roofing estimate in Norman, OK. No cost or obligation to ask, and your request is routed to a roofing provider serving your area."
  schema={schema}
>
  <PageHeader
    eyebrow="Free estimate"
    title="Request your free roof estimate"
    lede="No cost or obligation to ask. Tell us what's going on with the roof, and we'll pass your details to a roofing provider serving your area, who can arrange an on-site look and a written price."
  />

  <section class="section">
    <div class="container estimate">
      <div class="estimate__form">
        <LeadForm formId="free-estimate" heading="Tell us about your roof" />
      </div>

      <div class="estimate__side">
        <div class="callout">
          <p class="callout__label">Roof leaking right now?</p>
          <p class="callout__body">
            Call instead. Active water is an emergency and the phone is much faster than a form.
            Say so clearly and ask the provider about emergency tarping to stop water entering.
          </p>
          <a class="callout__phone" href={site.phone.href}>{site.phone.display}</a>
          <p class="callout__hours">{site.hours}</p>
        </div>

        <div class="whathappens">
          <h2 class="whathappens__title">What happens next</h2>
          <ol class="whathappens__list">
            {
              steps.map((step, i) => (
                <li>
                  <span class="whathappens__num">{i + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="notes">
          <h2 class="notes__title">Before you book</h2>
          <ul>
            <li>
              <strong>Requesting an estimate costs nothing.</strong> Submitting your details
              through this site carries no charge and no obligation. Ask the provider directly
              whether their on-site inspection itself is free — policies vary by contractor.
            </li>
            <li>
              <strong>Ask to keep any report or photographs.</strong> A dated photo report is
              useful for an insurance claim, a second opinion, or a house sale, regardless of who
              ends up doing the work.
            </li>
            <li>
              <strong>Storm damage? Get inspected before you file.</strong> If the damage is
              marginal, a claim may not be in your interest, and it's better to know that first.
            </li>
            <li>
              <strong>Treat any deductible offer as a red flag.</strong> Waiving or absorbing your
              insurance deductible is fraud under Oklahoma law. Walk away from any contractor who
              offers.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .estimate {
    display: grid;
    grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 68rem) {
    .estimate {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  /* --- Emergency callout ---------------------------------------------------- */

  .callout {
    padding: var(--space-m);
    background: var(--navy-900);
    color: var(--on-navy);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--copper-500);
  }

  .callout__label {
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--copper-400);
  }

  .callout__body {
    margin-top: 0.5rem;
    color: var(--on-navy-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .callout__phone {
    display: inline-block;
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
  }

  .callout__phone:hover {
    color: var(--copper-400);
  }

  .callout__hours {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--navy-400);
  }

  /* --- What happens next ---------------------------------------------------- */

  .whathappens {
    margin-top: var(--space-l);
  }

  .whathappens__title,
  .notes__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  .whathappens__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .whathappens__list li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .whathappens__num {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--copper-500);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .whathappens__list h3 {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .whathappens__list p {
    margin-top: 0.15rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* --- Notes ---------------------------------------------------------------- */

  .notes {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .notes li {
    position: relative;
    padding-left: 1.6rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    background: var(--copper-500);
    transform: rotate(45deg);
  }

  .notes strong {
    color: var(--navy-900);
  }
</style>
