---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../config/site';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const url = `${site.url}/services/`;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#page`,
    name: 'Roofing Services in Norman, OK',
    url,
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'ItemList',
    '@id': `${url}#list`,
    itemListElement: services.map((service, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: service.data.title,
      url: `${site.url}/services/${service.id}/`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: url },
    ],
  },
];
---

<BaseLayout
  title="Roofing Services in Norman, OK | Repair, Replace, Inspect"
  description="Every roofing service we offer in Norman, OK: repair, replacement, free inspections, storm and hail restoration, gutters, residential and commercial."
  schema={schema}
>
  <PageHeader
    eyebrow="Services"
    title="Roofing services in Norman, OK"
    lede="Seven services, each written for a homeowner with a specific problem. Every one starts with a free inspection and a written price. No roof gets quoted over the phone."
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section section--sunk section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2>The same four steps on every job</h2>
      </div>
      <ol class="steps">
        <li class="step">
          <span class="step__num">01</span>
          <h3 class="step__title">Free inspection</h3>
          <p class="step__body">
            Roof surface, penetrations, flashings and the attic where there's safe access. About
            an hour on a typical home.
          </p>
        </li>
        <li class="step">
          <span class="step__num">02</span>
          <h3 class="step__title">Photo report &amp; findings</h3>
          <p class="step__body">
            Dated, captioned photographs and a plain-English explanation. Yours to keep whether
            or not you hire us.
          </p>
        </li>
        <li class="step">
          <span class="step__num">03</span>
          <h3 class="step__title">Written price</h3>
          <p class="step__body">
            A line-itemed scope with the decking rate stated up front, so it's directly
            comparable to any other bid you're holding.
          </p>
        </li>
        <li class="step">
          <span class="step__num">04</span>
          <h3 class="step__title">The work</h3>
          <p class="step__body">
            Property protected, debris contained, and a magnetic nail sweep of yard, drive and
            street at the end of every day.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step {
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .step__num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1;
    color: var(--copper-100);
    -webkit-text-stroke: 1px var(--copper-500);
    margin-bottom: 0.6rem;
  }

  .step__title {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
  }

  .step__body {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
