---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../config/site';
import aboutImage from '../assets/images/placeholder-crew-blue-sky.jpg';

const url = `${site.url}/about/`;

const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${url}#page`,
    name: 'About Norman Roofing Experts',
    url,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: url },
    ],
  },
];
---

<BaseLayout
  title="About Norman Roofing Experts | Local Roofers, Norman OK"
  description="What Norman Roofing Experts is, how requesting a roof estimate here actually works, and what to check before hiring any Norman, OK roofing contractor."
  schema={schema}
>
  <PageHeader
    eyebrow="About us"
    title="A straightforward way to request roofing help in Norman"
    lede="Most bad roofing outcomes start the same way: a homeowner makes a five-figure decision based on someone's verbal assessment of a surface they can't see. This site exists to get you to a local provider faster, and to tell you plainly what to check before you hire anyone."
  />

  <section class="section">
    <div class="container about">
      <div class="about__body prose">
        <h2>What this site is</h2>
        <p>
          Norman Roofing Experts is a website, not a roofing crew. It doesn't send trucks, carry
          insurance, or perform inspections itself. What it does is collect the details of your
          roofing project through the phone number and forms on this site, and pass them along to
          a roofing provider serving your area, who then contacts you directly to schedule an
          inspection, answer questions and quote the work.
        </p>
        <p>
          There's no cost or obligation to submit a request. We'd rather say that plainly than
          have you assume you're speaking with an in-house crew when you're not.
        </p>

        <h2>What you can request</h2>
        <p>
          Roof repair, full replacement, inspections, storm and hail damage restoration, gutter
          installation and repair, and residential or light-commercial roofing work, for
          properties across Norman, the rest of Cleveland County and northern McClain County. See
          the <a href="/services/">services</a> and <a href="/service-areas/">service areas</a>
          pages for what's covered in each.
        </p>

        <h2>How a request turns into a quote</h2>
        <p>
          You send the form or call with a description of the problem and your location. That
          information goes to a roofing provider serving your area, who reaches out to arrange an
          on-site look at the roof. Any real price comes from that visit, not from this site — a
          number given without anyone seeing the roof is a number that will change once someone
          actually inspects it.
        </p>

        <h2>What to check before you hire anyone</h2>
        <p>
          These are the questions worth asking whichever roofing provider you end up working
          with, whether they come through this site or anywhere else. Most complaints in this
          trade trace back to one of these being skipped.
        </p>
        <ul>
          <li>
            <strong>Ask whether they'll waive or absorb your deductible.</strong> If they offer,
            walk away. Rebating, absorbing or advertising the waiving of an insurance deductible
            is fraud under Oklahoma law, and it exposes you as well as the contractor.
          </li>
          <li>
            <strong>Don't sign anything on your doorstep.</strong> Not a contract, not a
            contingency agreement, not anything. A decision worth making is worth making after
            you've read the paperwork and slept on it.
          </li>
          <li>
            <strong>Ask for the evidence, not just the verdict.</strong> A contractor who can show
            you dated photographs of what they found is easier to trust than one who tells you
            what you need without proof.
          </li>
          <li>
            <strong>Ask whether they tear off the old roof or lay over it.</strong> A layover
            hides decking damage you're about to cover for twenty years, adds weight and can
            complicate a future claim.
          </li>
          <li>
            <strong>Verify their registration and insurance independently.</strong> Don't take a
            verbal answer for it. Details below.
          </li>
        </ul>

        <h2>An honest note about reviews</h2>
        <p>
          You won't find a star rating or a review count on this site — there isn't a verified
          review corpus behind it to display, and a great many roofing sites show numbers they
          can't substantiate. Before you hire any Norman-area roofer, ask for references you can
          actually call, and check their standing directly rather than trusting a badge on a
          website.
        </p>

        <h2>Licensing and insurance</h2>
        <p>
          This site doesn't carry a roofing license or insurance policy — it isn't the entity
          doing the work. Whichever roofing provider you end up hiring should carry general
          liability and workers' compensation coverage and provide certificates on request before
          work starts. Ask for that of every contractor you consider, and verify it independently:
          if someone is injured on your roof and the contractor isn't properly insured, that can
          become your problem.
        </p>
        <p>
          Oklahoma requires roofing contractors to register with the state Construction Industries
          Board. Ask any contractor for their registration number and check it directly with the
          state. It takes a couple of minutes and it eliminates a meaningful share of the risk.
        </p>
      </div>

      <aside class="about__aside">
        <div class="about__media">
          <Image
            src={aboutImage}
            alt="Roofing crew working on a residential roof under a clear blue sky"
            widths={[420, 640, 900]}
            sizes="(max-width: 68rem) 100vw, 24rem"
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="factbox">
          <h2 class="factbox__title">At a glance</h2>
          <dl class="factbox__list">
            <div><dt>What this is</dt><dd>A roofing request &amp; referral website</dd></div>
            <div><dt>Coverage</dt><dd>Norman, Cleveland County, north McClain County</dd></div>
            <div><dt>Cost to request</dt><dd>Free, with no obligation</dd></div>
            <div><dt>Who does the work</dt><dd>A local roofing provider, contacted after you submit a request</dd></div>
            <div><dt>Quotes</dt><dd>From the provider, after an on-site inspection</dd></div>
            <div><dt>Deductible offers</dt><dd>Never. It's fraud in Oklahoma.</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <CTABand
    heading="Ready to get a straight answer on your roof?"
    body="Request a free, no-obligation estimate and we'll pass your details to a roofing provider serving your area."
  />
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 68rem) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  .about__body > :global(h2:first-child) {
    margin-top: 0;
  }

  .about__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .about__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .factbox {
    margin-top: var(--space-m);
    padding: var(--space-m);
    background: var(--navy-900);
    color: var(--on-navy);
    border-radius: var(--radius-lg);
  }

  .factbox__title {
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }

  .factbox__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .factbox__list > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .factbox__list > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .factbox dt {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-400);
  }

  .factbox dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.35;
    color: #fff;
  }
</style>
