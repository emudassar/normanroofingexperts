---
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Illustration from '../components/Illustration.astro';
import SectionHead from '../components/SectionHead.astro';
import CallButton from '../components/CallButton.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { toPlainText } from '../utils/inline-markdown';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const locations = (await getCollection('locations', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

/** Bento: the first service is the wide feature card; the rest fill a 3-column grid. */
const bentoSize = ['feature'];

const symptoms = [
  {
    icon: 'droplet',
    label: 'Water pouring in or a bulging ceiling',
    title: 'This is an emergency leak',
    body: 'When water is entering faster than you can catch it, or the ceiling is sagging, the priority is protection: buckets, power off near fixtures, and a temporary cover on the roof as soon as it is safe.',
    source: 'Open roof area, torn flashing or blown-off shingles',
    urgency: 'Call now',
    href: '/emergency-roof-leak-repair/',
    link: 'Emergency roof leak repair',
  },
  {
    icon: 'chimney',
    label: 'Stain beside the chimney or fireplace',
    title: 'Most likely the chimney',
    body: 'Water near the chimney breast usually comes from counter flashing pulling out of the mortar, a cracked crown, porous brick, or a missing cap. The repair depends on which of those is open.',
    source: 'Chimney flashing, crown, mortar or cap',
    urgency: 'Fix before winter',
    href: '/chimney-leak-repair/',
    link: 'Chimney leak repair',
  },
  {
    icon: 'vent',
    label: 'Small round stain under a bathroom',
    title: 'Probably a vent pipe boot',
    body: 'A ring-shaped stain under a bathroom or kitchen often traces to a cracked rubber boot around a plumbing vent, or to condensation in a fan duct. Both are usually quick to sort out.',
    source: 'Pipe boot, vent cap or exhaust duct',
    urgency: 'Book soon',
    href: '/roof-vent-leak-repair/',
    link: 'Roof vent leak repair',
  },
  {
    icon: 'wind',
    label: 'Leaks only in wind-driven rain',
    title: 'Look at the flashing',
    body: 'If the leak appears only when storms blow from one direction, rain is being pushed behind step, counter or kick-out flashing on the walls facing that wind.',
    source: 'Wall, dormer or valley flashing',
    urgency: 'Book soon',
    href: '/roof-flashing-repair/',
    link: 'Roof flashing repair',
  },
  {
    icon: 'skylight',
    label: 'Drips around a skylight',
    title: 'Flashing or condensation',
    body: 'Drips at the frame edges during rain point to flashing. Beads across the inside glass on cold, dry mornings are condensation. Fog between the panes means a failed glass seal.',
    source: 'Skylight flashing kit, seals or indoor humidity',
    urgency: 'Book soon',
    href: '/skylight-leak-repair/',
    link: 'Skylight leak repair',
  },
  {
    icon: 'flatroof',
    label: 'Water under a porch or addition roof',
    title: 'Check the low-slope roof',
    body: 'Porch, sunroom and addition roofs drain slowly. Leaks there usually start at open seams, ponding water, or the joint where the low roof meets the house wall.',
    source: 'Membrane seams, drains or wall flashing',
    urgency: 'Book soon',
    href: '/flat-roof-leak-repair/',
    link: 'Flat roof leak repair',
  },
  {
    icon: 'tree',
    label: 'Shingles in the yard after a storm',
    title: 'Storm damage to document',
    body: 'Missing shingles, a limb on the roof or torn flashing after high wind need temporary protection and dated photos before the permanent repair, especially if you plan to talk to your insurer.',
    source: 'Wind uplift or a falling limb',
    urgency: 'Call today',
    href: '/storm-damage-roof-repair/',
    link: 'Storm damage roof repair',
  },
  {
    icon: 'search',
    label: 'Leak keeps coming back',
    title: 'The real source was missed',
    body: 'A leak that returns after a patch usually means the wrong spot was fixed. Tracing the water path in the attic and testing sections one at a time finds where it really enters.',
    source: 'Hidden entry point, often uphill of the stain',
    urgency: 'Book soon',
    href: '/roof-leak-detection/',
    link: 'Roof leak detection',
  },
] as const;

const steps = [
  { title: 'You call', body: 'Describe where the water shows up, when it started and what the weather was. The call is free.' },
  { title: 'You are connected', body: `Your call goes to an independent roofing provider who serves ${site.city} and nearby towns.` },
  { title: 'They inspect', body: 'The provider checks inside and up top, traces the water, and explains what failed and why.' },
  { title: 'You decide', body: 'You get their price and plan for the repair. Nothing happens unless you agree to it.' },
];

const waiting = [
  { when: 'Day 1', body: 'Water soaks into attic insulation, which holds it against the ceiling drywall like a sponge.' },
  { when: 'Week 1', body: 'Drywall stains spread and can soften. Paint bubbles. Wet wood starts to darken around the entry point.' },
  { when: 'Month 1', body: 'Mold can take hold in damp insulation and framing, especially in humid Maryland summers.' },
  { when: 'Season 1', body: 'Roof decking softens and rots, and a one-piece flashing fix becomes decking, drywall and insulation work.' },
];

const costFactors = [
  ['Source of the leak', 'A cracked pipe boot is a small job. Rebuilding chimney flashing or a crown is much larger.'],
  ['How long it has leaked', 'Older leaks often mean wet insulation and rotted decking that must be replaced.'],
  ['Roof pitch and height', 'Steep or two-story roofs need more safety equipment and time.'],
  ['Roof material', 'Asphalt shingle, membrane flat roof and metal each use different materials and skills.'],
  ['Access', 'Tight attics, landscaping or tall trees around the house can slow the work.'],
  ['Timing', 'After-hours or active-storm visits and temporary tarping are often priced separately.'],
];

const faqs = [
  {
    question: 'How do I know where my roof is leaking from?',
    answer: 'Start in the attic with a flashlight and follow the wet trail uphill to the highest damp spot. The entry point is usually just above it. The stain on your ceiling is often several feet away from the actual opening. If you can\'t find it, [roof leak detection](/roof-leak-detection/) traces it methodically.',
  },
  {
    question: 'Is a roof leak an emergency?',
    answer: 'It is when water is entering faster than you can catch it, near electrical fixtures, through a sagging ceiling, or through a visible opening. A small stain that hasn\'t grown can usually wait for a scheduled visit, but not for months.',
  },
  {
    question: 'Can a roof leak be repaired in the rain?',
    answer: 'A permanent repair usually needs a dry surface. In the rain, the work is temporary protection: a tarp or membrane patch, put on only when wind and lightning make it safe. The lasting fix follows in dry weather.',
  },
  {
    question: 'What is the most common cause of roof leaks?',
    answer: 'Flashing: the metal that seals joints at walls, chimneys, skylights and valleys. Cracked rubber pipe boots and wind-damaged shingles come next. See [roof flashing repair](/roof-flashing-repair/).',
  },
  {
    question: 'Should I repair the leak or replace the roof?',
    answer: 'Most leaks come from one failed detail and can be repaired. Replacement makes sense when shingles are brittle and leaking in many places. Ask the provider for photos of the roof\'s overall condition so you can judge.',
  },
  {
    question: 'Does homeowners insurance cover roof leaks?',
    answer: 'It depends on your policy and the cause. Sudden storm damage is treated differently from age and wear. Take dated photos, keep receipts for temporary repairs, and contact your insurer. Only the insurer decides coverage.',
  },
  {
    question: 'Who will I be talking to when I call?',
    answer: `${site.name} is a referral service. Your call is connected to an independent local roofing provider who serves ${site.city}. That provider quotes and does the work.`,
  },
  {
    question: 'Is it free to call?',
    answer: 'Yes. Calling to describe your leak and be connected is free and doesn\'t commit you to anything. Any charges for inspection or repair are set by the provider, so ask them before work begins.',
  },
  {
    question: 'Which areas around Severna Park are covered?',
    answer: 'Severna Park (21146) and nearby Anne Arundel County communities, including [Arnold](/roof-leak-repair-arnold-md/), [Pasadena](/roof-leak-repair-pasadena-md/), [Millersville](/roof-leak-repair-millersville-md/), [Severn](/roof-leak-repair-severn-md/) and [Glen Burnie](/roof-leak-repair-glen-burnie-md/).',
  },
  {
    question: 'What can I do right now while I wait?',
    answer: 'Move belongings, catch the water, switch off power to any wet fixture, photograph the damage, and stay off the roof. If a ceiling bulges, keep people out from under it.',
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${site.url}/#webpage`,
    url: `${site.url}/`,
    name: `Roof Leak Repair in ${site.city}, ${site.state}`,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#service` },
  },
  {
    '@type': 'Service',
    '@id': `${site.url}/#service`,
    name: `Roof leak repair in ${site.city}, ${site.stateName}`,
    serviceType: 'Roof leak repair',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Roof leak repairs',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.data.title, url: `${site.url}/${s.id}/` },
      })),
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: toPlainText(f.answer) },
    })),
  },
];
---

<BaseLayout
  title={`Roof Leak Repair ${site.city}, ${site.state} | ${site.name}`}
  description="Roof leaking in Severna Park, MD? Find the source fast: flashing, chimneys, skylights, vents, flat roofs. Call (773) 302-2292 to reach a local roofer."
  isHome
  schema={schema}
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero__mesh" aria-hidden="true"></div>
    <div class="hero__grain" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">{site.city}, {site.stateName} · {site.county}</span>
        <h1><span class="hl">Roof Leak Repair</span> in {site.city}, MD</h1>
        <p class="hero__lede">
          Water on the ceiling, a drip by the chimney, or shingles in the yard after a nor'easter? One call connects
          you with a local roofer who traces the leak to where it really gets in and repairs it properly, instead of
          smearing more caulk over the stain.
        </p>
        <div class="hero__actions">
          <CallButton />
          <a class="btn btn--light" href="#checker">What's causing my leak?</a>
        </div>
        <ul class="chips" aria-label="Why call">
          <li class="chip"><Icon name="droplet" />Leak repair only</li>
          <li class="chip"><Icon name="pin" />Local to {site.city}</li>
          <li class="chip"><Icon name="phone" />Free call, no forms</li>
        </ul>
        <p class="hero__fine">{site.disclosure}</p>
      </div>

      <div class="hero__art">
        <HeroScene />
        <div class="glass-card glass-card--a">
          <span class="icon-tile"><Icon name="layers" /></span>
          <div><strong>Flashing</strong><span>The #1 place leaks start</span></div>
        </div>
        <div class="glass-card glass-card--b">
          <span class="icon-tile"><Icon name="search" /></span>
          <div><strong>Traced, not guessed</strong><span>Water runs before it drips</span></div>
        </div>
        <div class="glass-card glass-card--c">
          <span class="icon-tile"><Icon name="phone" /></span>
          <div><strong>{site.phone.display}</strong><span>Free to call</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INTRO / DIRECT ANSWER ===================== -->
  <section class="section section--white" aria-labelledby="intro-title">
    <div class="container">
      <SectionHead eyebrow="The short answer" title="How do you fix a leaking roof in Severna Park?" id="intro-title" />
      <div class="answer">
        <div class="stack" data-reveal>
          <p class="answer__lead">
            Find where water actually enters, stop it temporarily if it's still raining, then repair the failed detail
            properly once the roof is dry. On most homes that detail is flashing, a vent boot, a chimney or a skylight,
            not the open field of shingles.
          </p>
          <p>
            That's the whole method, and it's why this site focuses on leaks and nothing else. A leak is a water-path
            problem. Rain gets in at one spot, runs along the underlayment or a rafter, and drips onto your ceiling
            wherever gravity sends it. Patch the stain's location and the leak usually comes back. Trace it uphill and
            fix the real opening, and it stays fixed.
          </p>
          <p>
            Around {site.city}, the weather makes that tracing important. Nor'easters drive rain sideways for hours,
            summer thunderstorms dump water fast, tall trees drop limbs and fill valleys with leaves, and winter
            freeze-thaw cycles open cracks in chimneys and sealant. If water is coming in right now, go straight to
            <a href="/emergency-roof-leak-repair/">emergency roof leak repair</a>. If you're not sure where it starts,
            <a href="/roof-leak-detection/">roof leak detection</a> explains how professionals find it.
          </p>
        </div>
        <aside class="answer__card" data-reveal aria-label="Do this first">
          <h3>Do this in the first 10 minutes</h3>
          <ul class="checklist">
            <li><Icon name="check" /><span>Move furniture and electronics; put down buckets and towels.</span></li>
            <li><Icon name="check" /><span>Switch off the breaker for any wet light or outlet.</span></li>
            <li><Icon name="check" /><span>Photograph the stain, the ceiling and the outside of the roof.</span></li>
            <li><Icon name="check" /><span>Stay off the roof, especially when it's wet.</span></li>
            <li><Icon name="check" /><span>Call and describe where the water appears.</span></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES BENTO ===================== -->
  <section class="section section--off" id="services" aria-labelledby="services-title">
    <Divider color="#ffffff" />
    <div class="container">
      <SectionHead eyebrow="Leak repairs" title="Every way a roof leaks, and how each one is fixed" id="services-title">
        Eight specialised leak repairs, each with its own guide. Pick the one that matches what you're seeing, or call
        and describe it.
      </SectionHead>
      <div class="bento">
        {
          services.map((s, i) => (
            <article class:list={['card', bentoSize[i] && `bento__card--${bentoSize[i]}`]} data-reveal>
              {i === 0 && <span class="bento__tag">Water coming in now</span>}
              <span class="icon-tile"><Icon name={s.data.icon as any} /></span>
              <h3><a href={`/${s.id}/`}>{s.data.title}</a></h3>
              <p>{s.data.blurb}</p>
              <span class="text-link">{i === 0 ? 'What to do first' : 'Read the guide'} <Icon name="arrow" /></span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== SYMPTOM CHECKER ===================== -->
  <section class="section section--tint" id="checker" aria-labelledby="checker-title">
    <div class="container">
      <SectionHead eyebrow="Symptom checker" title="What is your leak telling you?" id="checker-title">
        Where and when water shows up says a lot about where it gets in. Pick the symptom closest to yours to see the
        most likely source and the repair that usually fixes it. It's a starting point, not a diagnosis; a roofer
        confirms it on site.
      </SectionHead>
      <div class="checker" data-checker>
        <div class="checker__tabs" role="tablist" aria-label="Leak symptoms" aria-orientation="vertical">
          {
            symptoms.map((s, i) => (
              <button class="checker__tab" type="button" role="tab" id={`sym-tab-${i}`} aria-controls={`sym-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
                <Icon name={s.icon} />
                {s.label}
              </button>
            ))
          }
        </div>
        <div class="checker__panels">
          {
            symptoms.map((s, i) => (
              <div class="checker__panel" role="tabpanel" id={`sym-panel-${i}`} aria-labelledby={`sym-tab-${i}`} tabindex="0">
                <p class="eyebrow">{s.label}</p>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <div class="checker__meta">
                  <span class="badge"><Icon name="search" />Likely source: {s.source}</span>
                  <span class="badge badge--hot"><Icon name="clock" />{s.urgency}</span>
                </div>
                <a class="text-link" href={s.href}>{s.link} <Icon name="arrow" /></a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== IN-DEPTH GUIDE ===================== -->
  <section class="section section--white" aria-labelledby="guide-title">
    <div class="container">
      <SectionHead eyebrow="The guide" title="Roof leaks in Severna Park: causes, detection and what happens next" id="guide-title">
        A plain explanation of why roofs here leak, how the source is found, and what a proper repair looks like.
      </SectionHead>

      <div class="split" data-reveal>
        <div class="split__art"><Illustration name="flashing" /></div>
        <div class="split__body">
          <span class="eyebrow">Causes</span>
          <h3>Why do roofs leak around Severna Park?</h3>
          <p>
            Shingles shed water well across an open slope. Leaks almost always start where that slope is interrupted:
            a wall, a chimney, a skylight, a vent pipe or a valley. Those joints are sealed with flashing and
            sealant, and they're where age, movement and weather do their damage first. That's why
            <a href="/roof-flashing-repair/">roof flashing repair</a> is the most common leak fix, followed by
            cracked rubber boots that call for <a href="/roof-vent-leak-repair/">roof vent leak repair</a>.
          </p>
          <p>
            Local conditions add pressure. The land between the Severn and Magothy rivers catches wind off open
            water, so storms push rain sideways under flashing that stays dry in a calm shower. Mature trees fill
            valleys and gutters with leaves and drop limbs in high wind, a leading cause of
            <a href="/storm-damage-roof-repair/">storm damage roof repair</a>. Humid summers and freezing winter nights
            crack chimney crowns and mortar, which is where <a href="/chimney-leak-repair/">chimney leak repair</a>
            comes in.
          </p>
          <aside class="callout callout--tip"><p><strong>Pro tip:</strong> Note the wind direction when your leak appears. A leak that only shows up in storms from one side points straight at the flashing on that side.</p></aside>
        </div>
      </div>

      <div class="split split--reverse" data-reveal>
        <div class="split__art"><Illustration name="trace" /></div>
        <div class="split__body">
          <span class="eyebrow">Detection</span>
          <h3>How is the source of a leak found?</h3>
          <p>
            Water travels before it drips. A good roofer starts inside: the stain, then the attic, following water
            marks on rafters and decking uphill to the highest wet point. The entry is usually directly above it or a
            little further up the slope.
          </p>
          <p>
            Next comes the roof itself: every flashing joint, boot, skylight frame and valley above that point. When
            two or three features are suspects, a controlled water test settles it. One person runs a hose on a small
            section while another watches inside, moving uphill section by section. On
            <a href="/flat-roof-leak-repair/">flat and low-slope roofs</a>, moisture meters and sometimes thermal
            imaging map wet insulation under the membrane. Around skylights, the first question is whether it's a leak
            at all; condensation is common, and <a href="/skylight-leak-repair/">skylight leak repair</a> explains how
            to tell.
          </p>
          <aside class="callout callout--warn"><p><strong>Warning:</strong> In the attic, step only on joists. Ceiling drywall won't hold your weight, and a foot through the ceiling turns a leak into a much bigger repair.</p></aside>
        </div>
      </div>

      <div class="split" data-reveal>
        <div class="split__art"><Illustration name="ceiling" /></div>
        <div class="split__body">
          <span class="eyebrow">After the call</span>
          <h3>What happens after the leak is found?</h3>
          <p>
            If it's still raining, the first step is temporary: a tarp fastened over the ridge, or a membrane patch
            over a small opening. Once the roof is dry, the permanent repair replaces whatever failed, whether new step
            flashing woven under lifted shingles, a new pipe boot, a rebuilt chimney crown, or fresh seams on a
            flat roof.
          </p>
          <p>
            A careful provider also checks for hidden damage: soft decking around the opening, soaked insulation and
            wet drywall. Wet insulation should be pulled and replaced, because it holds moisture against the ceiling
            and invites mold. Ask for before-and-after photos of anything that will be covered up, so you can see what
            was done. If a leak was patched before and came back, that's a sign the real source was missed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="section section--dark" aria-labelledby="process-title">
    <Divider shape="angle" color="#ffffff" />
    <div class="container">
      <SectionHead eyebrow="How it works" title="From first drip to fixed, in four steps" id="process-title">
        No forms, no waiting for an email. You talk to a person about your roof, and the provider takes it from there.
      </SectionHead>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== COST OF WAITING ===================== -->
  <section class="section section--dark" aria-labelledby="waiting-title" style="padding-top:0">
    <div class="container">
      <SectionHead eyebrow="Why it can't wait" title="What a small leak costs when it's left alone" id="waiting-title">
        A slow drip looks harmless because most of the damage happens out of sight. Here's the usual progression when
        a roof leak goes unrepaired.
      </SectionHead>
      <div class="wait-grid">
        {
          waiting.map((w) => (
            <div class="wait-card" data-reveal>
              <span class="wait-card__when">{w.when}</span>
              <p>{w.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-lg" data-reveal>
        The longer water runs, the more trades a repair involves: roofing, then carpentry, insulation, drywall and
        paint. A leak that a pipe boot or a few feet of flashing would fix in week one can mean ceiling and decking
        work by the end of a wet season. Acting early is the single biggest thing you can do to keep a repair small.
      </p>
    </div>
  </section>

  <!-- ===================== COST FACTORS ===================== -->
  <section class="section section--white" aria-labelledby="cost-title">
    <Divider color="#06121f" />
    <div class="container container--narrow">
      <SectionHead eyebrow="Pricing" title="What affects the cost of roof leak repair?" id="cost-title">
        Every leak is priced by the provider after they've seen it. These are the factors that move the number up or
        down, so you know what to ask about.
      </SectionHead>
      <div class="table-wrap" data-reveal>
        <table>
          <thead><tr><th scope="col">Factor</th><th scope="col">Why it matters</th></tr></thead>
          <tbody>{costFactors.map(([f, why]) => <tr><td>{f}</td><td>{why}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="mt-lg" data-reveal>
        Ask the provider to separate temporary work from the permanent repair in their price, and to tell you before
        starting if they find rotted decking or wet insulation. A clear scope up front prevents surprises later.
      </p>
    </div>
  </section>

  <!-- ===================== AREAS ===================== -->
  <section class="section section--tint" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <SectionHead eyebrow="Service area" title="Roof leak repair in Severna Park and nearby towns" id="areas-title">
        Calls from {site.city} and the surrounding Anne Arundel County communities are connected to a local provider.
        Each town has its own typical leak pattern.
      </SectionHead>
      <div class="area-grid">
        <article class="card area-card--map" data-reveal>
          <span class="area-card__zip" style="color:var(--accent)">ZIP {site.zip}</span>
          <h3>{site.city}</h3>
          <p>
            Between the Severn and Magothy rivers, with the B&amp;A Trail running through town and plenty of mature
            trees. Wind-driven rain, leafy valleys and older brick chimneys make flashing and chimney leaks the most
            common calls here.
          </p>
          <Illustration name="map" />
        </article>
        {
          locations.map((l) => (
            <article class="card" data-reveal>
              <span class="area-card__zip">ZIP {l.data.zip}</span>
