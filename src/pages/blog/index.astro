---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../config/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const url = `${site.url}/blog/`;

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#page`,
    name: 'Roof Guides | Norman Roofing Experts',
    url,
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Roof Guides', item: url },
    ],
  },
];
---

<BaseLayout
  title="Roof Guides for Oklahoma Homeowners | Norman Roofing"
  description="Practical guides for Norman, OK homeowners: hail season, the Oklahoma insurance claim process, and which roofing materials actually survive this climate."
  schema={schema}
>
  <PageHeader
    eyebrow="Roof guides"
    title="Guides for Oklahoma homeowners"
    lede="Longer pieces on the things that actually cost Norman homeowners money: hail season, insurance claims, and choosing materials for a climate that is hard on roofs."
    current="Roof Guides"
  />

  <section class="section">
    <div class="container">
      <div class="posts">
        {
          posts.map((post, i) => (
            <article class="post">
              <div class="post__media">
                <Image
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 55rem) 100vw, 22rem"
                  format="webp"
                  quality={70}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="post__body">
                <p class="post__meta">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {dateFormat.format(post.data.publishDate)}
                  </time>
                  {post.data.tags.length > 0 && <span class="post__dot">·</span>}
                  {post.data.tags.slice(0, 2).join(' · ')}
                </p>
                <h2 class="post__title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="post__excerpt">{post.data.excerpt}</p>
                <p class="post__more">Read the guide &rarr;</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .post {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: center;
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--line);
  }

  .post:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  @media (max-width: 55rem) {
    .post {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }

  .post__media {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-sunk);
  }

  .post__media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post:hover .post__media :global(img) {
    transform: scale(1.03);
  }

  .post__meta {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--copper-600);
  }

  .post__dot {
    margin-inline: 0.35rem;
    color: var(--line-strong);
  }

  .post__title {
    margin-top: 0.5rem;
    font-size: var(--step-2);
  }

  .post__title a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post:hover .post__title a {
    color: var(--copper-700);
  }

  .post__excerpt {
    margin-top: var(--space-xs);
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 44rem;
  }

  .post__more {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--copper-600);
  }
</style>
