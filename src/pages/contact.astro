---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';

const url = `${site.url}/contact/`;

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${url}#page`,
    name: 'Contact Norman Roofing Experts',
    url,
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: url },
    ],
  },
];
---

<BaseLayout
  title="Contact Norman Roofing Experts | Norman, OK Roofers"
  description="Call or message Norman Roofing Experts to request roof repair, replacement or an inspection in Norman, Cleveland County and northern McClain County, OK."
  schema={schema}
>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    lede="Call for anything urgent: an active leak, storm damage, water coming through a ceiling. Use the form for everything else, and your request will be passed to a roofing provider serving your area."
  />

  <section class="section">
    <div class="container contact">
      <div class="contact__details">
        <div class="detail detail--primary">
          <p class="detail__label">Phone</p>
          <a class="detail__phone" href={site.phone.href}>{site.phone.display}</a>
          <p class="detail__note">
            Fastest route for anything urgent. Storm-season call volume across the area can be
            heavy, so leave a message if it goes unanswered.
          </p>
        </div>

        <div class="detail">
          <p class="detail__label">Email</p>
          <p class="detail__value"><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p class="detail__note">
            Good for photographs, insurance paperwork and anything that isn't time-critical.
          </p>
        </div>

        <div class="detail">
          <p class="detail__label">Hours</p>
          <p class="detail__value">{site.hours}</p>
          <p class="detail__note">
            How quickly a provider can respond to an active leak varies by season and by
            provider — say so clearly in your request.
          </p>
        </div>

        <div class="detail">
          <p class="detail__label">Where this covers</p>
          <p class="detail__value">Norman, Cleveland County &amp; northern McClain County</p>
          <p class="detail__note">
            Including Noble, Lexington, Slaughterville, Washington, Little Axe and Goldsby. See
            the full list on the <a href="/service-areas/">service areas page</a>.
          </p>
        </div>

        <div class="detail detail--muted">
          <p class="detail__label">How this works</p>
          <p class="detail__note detail__note--lead">
            This site doesn't send its own crews — roofing happens at your property, and the
            provider who takes your request is the one who comes out and inspects. Reach out by
            phone or through the form and your details go to a roofing provider serving your area.
          </p>
        </div>
      </div>

      <div class="contact__form">
        <LeadForm
          formId="contact"
          heading="Send a message"
          lede="Tell us what's happening with the roof and where you are. We'll pass it to a roofing provider serving your area, who will follow up about an inspection."
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 68rem) {
    .contact {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  .detail {
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .detail:last-child {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .detail__label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper-600);
    margin-bottom: 0.4rem;
  }

  .detail__phone {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--navy-900);
    text-decoration: none;
  }

  .detail__phone:hover {
    color: var(--copper-600);
  }

  .detail__value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.35;
    color: var(--navy-900);
  }

  .detail__value a {
    color: inherit;
    text-decoration: none;
  }

  .detail__value a:hover {
    color: var(--copper-600);
  }

  .detail__note {
    margin-top: 0.45rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 34rem;
  }

  .detail__note--lead {
    margin-top: 0;
  }

  .detail--muted {
    padding: var(--space-m);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
</style>
