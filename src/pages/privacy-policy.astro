---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const url = `${site.url}/privacy-policy/`;

const schema = [
  { '@type': 'WebPage', '@id': `${url}#page`, name: 'Privacy Policy', url, isPartOf: { '@id': `${site.url}/#website` } },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: url },
    ],
  },
];
---

<BaseLayout
  title={`Privacy Policy | ${site.name}`}
  description="How Norman Roofing Experts handles information from website visits and phone calls about roof leak repair in Severna Park, MD."
  schema={schema}
>
  <PageHero eyebrow="Legal" title="Privacy Policy" lede="Effective October 2026." crumb="Privacy Policy" showCall={false} />

  <section class="section section--white">
    <div class="container container--narrow prose legal">
      <p>
        This policy explains what information {site.name} ("we", "us") collects through
        <strong>normanroofingexperts.com</strong> and through calls made to the phone number shown on it, why, and what
        happens to it.
      </p>

      <h2>Who we are</h2>
      <p>
        {site.name} is a referral website. We don't perform roofing work. Calls to {site.phone.display} are connected to
        an independent roofing provider serving {site.city}, {site.stateName} and nearby communities.
      </p>

      <h2>Information we collect</h2>
      <h3>When you call</h3>
      <p>
        The site has no contact or quote forms. When you call, the call-routing service that connects you may record
        your phone number, the time and length of the call, and the page or campaign the call came from. Calls may be
        recorded for quality and billing purposes; where this happens, you'll normally hear a notice at the start of the
        call. Anything you tell the provider during the call is received and handled by that provider.
      </p>
      <h3>When you email us</h3>
      <p>We receive your email address and whatever you include in your message.</p>
      <h3>When you browse</h3>
      <p>
        Our hosting provider records standard technical data when pages are requested (IP address, browser, device,
        referring page and timestamps) for security and troubleshooting. We use Google Analytics to understand which
        pages are useful, including counting clicks on the call button. Google Analytics uses cookies; you can block
        or delete them in your browser and the site will still work.
      </p>

      <h2>How we use it</h2>
      <ul>
        <li>To connect your call to a roofing provider serving your area.</li>
        <li>To reply to emails you send us.</li>
        <li>To measure and improve the website.</li>
        <li>To keep records needed for billing with our call-routing and provider partners.</li>
      </ul>

      <h2>Sharing</h2>
      <ul>
        <li><strong>Roofing providers.</strong> Your call, and anything you say on it, goes to the provider you're connected with.</li>
        <li><strong>Service providers.</strong> Hosting, analytics and call-routing services that operate the site and calls on our behalf.</li>
        <li><strong>Where the law requires it.</strong> In response to a valid legal request.</li>
      </ul>
      <p><strong>We don't sell your personal information</strong> or add you to marketing lists.</p>

      <h2>How long we keep it</h2>
      <p>
        Call records and emails are kept only as long as needed for the purposes above, including billing
        reconciliation, and then deleted. Analytics data is kept according to Google Analytics retention settings.
      </p>

      <h2>Your choices</h2>
      <p>
        You can ask what information we hold about you, ask us to correct it, or ask us to delete it, subject to records
        we must keep. Email <a href={`mailto:${site.email}`}>{site.email}</a>. For information you gave a roofing provider,
        contact that provider directly.
      </p>

      <h2>Children</h2>
      <p>This site is meant for adults arranging work on property they own or manage. We don't knowingly collect information from children under 13.</p>

      <h2>Changes</h2>
      <p>We may update this policy. The effective date above changes when we do.</p>

      <h2>Contact</h2>
      <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <hr />
      <p>Website owner: Muhammad Mudassar Sharif<br />Last updated: October 21, 2026</p>
    </div>
  </section>
</BaseLayout>
