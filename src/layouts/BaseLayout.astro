---
import { Font } from 'astro:assets';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** <title> content. Must be unique across the site, ≤60 chars. */
  title: string;
  /** Meta description. Must be unique across the site, ≤155 chars. */
  description: string;
  /** Path-only canonical override. Defaults to the current URL. */
  canonicalPath?: string;
  ogImage?: string;
  /** Keep the page out of the index (404 only). */
  noindex?: boolean;
  /** Home page carries the Organization + WebSite nodes. */
  isHome?: boolean;
  /** Extra JSON-LD graph nodes for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, canonicalPath, ogImage = site.defaultOgImage, noindex = false, isHome = false, schema = [] } = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

/**
 * Organization only, never LocalBusiness: there is no physical address and no
 * Google Business Profile behind this site, so a LocalBusiness node would be a
 * fabricated one. Inner pages reference it by @id.
 */
const organizationSchema = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/favicon.svg`,
  description: site.description,
  telephone: '+1-773-302-2292',
  email: site.email,
  areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-773-302-2292',
    contactType: 'customer service',
    areaServed: 'US-MD',
    availableLanguage: 'English',
  },
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  description: site.description,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'en-US',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...(isHome ? [organizationSchema, websiteSchema] : []), ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="xUsteo_DEnpzkQmYFBB4WMec-ZV-FDgKMs6rjJAIVjk" />
    <meta name="msvalidate.01" content="5CF4F6B4ACD5B2DF0D614FA07B0E5015" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#0b2545" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd['@graph'].length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H5GXEGN5CN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-H5GXEGN5CN');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
