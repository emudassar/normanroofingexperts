---
import type { CollectionEntry } from 'astro:content';
import { getEntries, render } from 'astro:content';
import { site } from '../config/site';
import BaseLayout from './BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { toPlainText } from '../utils/inline-markdown';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const relatedServices = await getEntries(d.relatedServices);
const relatedLocations = await getEntries(d.relatedLocations);

const url = `${site.url}/${entry.id}/`;
const toc = [
  ...headings.filter((h) => h.depth === 2),
  { slug: 'faqs', text: `${d.title} FAQs` },
  { slug: 'related', text: 'Related repairs and areas' },
];

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: d.h1,
    serviceType: d.title,
    description: d.description,
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: [
      { '@type': 'Place', name: `${site.city}, ${site.stateName}` },
      ...relatedLocations.map((l) => ({ '@type': 'Place', name: `${l.data.title}, ${site.stateName}` })),
    ],
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: toPlainText(f.answer) },
    })),
  },
];
---

<BaseLayout title={`${d.metaTitle} | ${site.shortName}`} description={d.description} schema={schema}>
  <ArticleShell eyebrow={`Leak repair · ${site.city}, ${site.state}`} h1={d.h1} lede={d.lede} crumb={d.title} toc={toc} callTitle={`Need ${d.title.toLowerCase()} now?`}>
    <Content />

    <h2 id="faqs">{d.title} FAQs</h2>
    <FAQ faqs={d.faqs} />

    <h2 id="related">Related repairs and areas</h2>
    <div class="related">
      {
        relatedServices.map((s) => (
          <article class="card">
            <span class="icon-tile"><Icon name={s.data.icon as any} /></span>
            <h3><a href={`/${s.id}/`}>{s.data.title}</a></h3>
            <span class="text-link">Read more <Icon name="arrow" /></span>
          </article>
        ))
      }
      {
        relatedLocations.map((l) => (
          <article class="card bento__card--accent">
            <span class="icon-tile icon-tile--accent"><Icon name="pin" /></span>
            <h3><a href={`/${l.id}/`}>Roof leak repair in {l.data.title}</a></h3>
            <span class="text-link">See the area <Icon name="arrow" /></span>
          </article>
        ))
      }
    </div>
  </ArticleShell>

  <CTABand title={`Get ${d.title.toLowerCase()} help in ${site.city} today`} text="Call and describe what you're seeing. You'll be connected with a local roofing provider who can look at it." />
</BaseLayout>
