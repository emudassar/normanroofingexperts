---
import type { CollectionEntry } from 'astro:content';
import { getEntries } from 'astro:content';
import { site } from '../config/site';
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import DetailHero from '../components/DetailHero.astro';
import ContentSections from '../components/ContentSections.astro';
import CallButton from '../components/CallButton.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { toPlainText } from '../utils/inline-markdown';
import { splitSections } from '../utils/sections';
import { sharedPhoto } from '../utils/photos';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const d = entry.data;
const sections = splitSections(entry.rendered?.html ?? '', 'service');
const relatedServices = await getEntries(d.relatedServices);
const relatedLocations = await getEntries(d.relatedLocations);

const url = `${site.url}/${entry.id}/`;
const media = {
  ...(d.image && { about: { src: d.image, alt: d.imageAlt ?? '' } }),
  checks: sharedPhoto(d.order % 2 ? 'ceiling-stain' : 'attic-check'),
  visit: sharedPhoto('roofer-inspection'),
};

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: d.h1,
    serviceType: d.title,
    description: d.description,
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: [
      { '@type': 'Place', name: `${site.city}, ${site.stateName}` },
      ...relatedLocations.map((l) => ({ '@type': 'Place', name: `${l.data.title}, ${site.stateName}` })),
    ],
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: toPlainText(f.answer) },
    })),
  },
];
---

<BaseLayout title={`${d.metaTitle} | ${site.shortName}`} description={d.description} schema={schema}>
  <DetailHero
    eyebrow={`Leak repair · ${site.city}, ${site.state}`}
    h1={d.h1}
    lede={d.lede}
    crumb={d.title}
    image={d.heroImage}
    imageAlt={d.heroAlt}
    cardLabel="Talk to a pro"
    cardTitle={`Need ${d.title.toLowerCase()} now?`}
    cardItems={['One call, no forms', `Local ${site.city}-area provider`, 'Free to call, no obligation']}
  />

  <ContentSections sections={sections} type="service" media={media} place={site.city} />

  <section class="section section--white faq-section">
    <div class="container faq-layout">
      <div class="faq-layout__head" data-reveal>
        <span class="eyebrow">Questions</span>
        <h2 id="faqs">{d.title} FAQs</h2>
        <div class="call-card">
          <p class="call-card__title">Still not sure what you're seeing?</p>
          <a class="call-card__phone" href={site.phone.href} data-call>{site.phone.display}</a>
          <CallButton label="Call now" />
        </div>
      </div>
      <FAQ faqs={d.faqs} />
    </div>
  </section>

  <section class="section section--off">
    <div class="container">
      <header class="section-head section-head--center" data-reveal>
        <span class="eyebrow">Keep reading</span>
        <h2 id="related">Related repairs and areas</h2>
      </header>
      <div class="photo-cards">
        {
          relatedServices.map((s) => (
            <article class="photo-card">
              {s.data.image ? (
                <Image src={s.data.image} alt={s.data.imageAlt ?? s.data.title} widths={[400, 640]} sizes="(min-width: 1024px) 380px, 100vw" format="webp" loading="lazy" />
              ) : (
                <span class="photo-card__icon"><Icon name={s.data.icon as any} /></span>
              )}
              <div class="photo-card__body">
                <span class="photo-card__tag">Leak repair</span>
                <h3><a href={`/${s.id}/`}>{s.data.title}</a></h3>
                <span class="text-link">Read more <Icon name="arrow" /></span>
              </div>
            </article>
          ))
        }
      </div>
      <div class="area-chips">
        {
          relatedLocations.map((l) => (
            <a href={`/${l.id}/`}><Icon name="pin" />Roof leak repair in {l.data.title}</a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand title={`Get ${d.title.toLowerCase()} help in ${site.city} today`} text="Call and describe what you're seeing. You'll be connected with a local roofing provider who can look at it." />
</BaseLayout>
