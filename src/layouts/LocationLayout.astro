---
import type { CollectionEntry } from 'astro:content';
import { getEntries, render } from 'astro:content';
import { site } from '../config/site';
import BaseLayout from './BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { toPlainText } from '../utils/inline-markdown';

interface Props {
  entry: CollectionEntry<'locations'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const services = await getEntries(d.relatedServices);

const url = `${site.url}/${entry.id}/`;
const toc = [...headings.filter((h) => h.depth === 2), { slug: 'faqs', text: `${d.title} roof leak FAQs` }];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: d.h1,
    description: d.description,
    url,
    isPartOf: { '@id': `${site.url}/#website` },
    about: {
      '@type': 'Service',
      name: `Roof leak repair in ${d.title}, ${site.state}`,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: { '@type': 'Place', name: `${d.title}, ${site.stateName} ${d.zip}` },
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: `${d.title}, MD`, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: toPlainText(f.answer) },
    })),
  },
];
---

<BaseLayout title={`${d.metaTitle} | ${site.shortName}`} description={d.description} schema={schema}>
  <ArticleShell eyebrow={`Service area · ${d.title}, MD ${d.zip}`} h1={d.h1} lede={d.lede} crumb={`${d.title}, MD`} toc={toc} callTitle={`Roof leaking in ${d.title}?`}>
    <Content />

    <h2 id="faqs">{d.title} roof leak FAQs</h2>
    <FAQ faqs={d.faqs} />

    <div class="related mt-lg">
      {
        services.map((s) => (
          <article class="card">
            <span class="icon-tile"><Icon name={s.data.icon as any} /></span>
            <h3><a href={`/${s.id}/`}>{s.data.title}</a></h3>
            <span class="text-link">Read more <Icon name="arrow" /></span>
          </article>
        ))
      }
    </div>
  </ArticleShell>

  <CTABand eyebrow={`${d.title}, MD`} title={`Water coming through a ${d.title} ceiling? Call now.`} text="Tell the provider where the water shows up and when it started. That's all you need for the first call." />
</BaseLayout>
